{
	"schemaVersion": 1,
	"id": "crying",
	"version": "${version}",
	"name": "Crying Tools",
	"description": "Crying Tools is a Minecraft mod that expands upon the Crying Obsidian with new items, tools and blocks.",
	"authors": [
		"Thomas Darkson"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/crying",
		"sources": "https://github.com/ThomasDarkson/crying"
	},
	"license": "Apache",
	"icon": "assets/crying/icon.png",
	"environment": "*",
	"entrypoints": {
		"server": [
			"crying.CryingServer"
		],
		"client": [
			"crying.CryingClient"
		],
		"main": [
			"crying.Crying"
		]
	},
	"mixins": [
		"crying.mixins.json",
		{
			"config": "crying.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": [
		   "1.21.11"
		],
		"java": ">=21",
		"fabric-api": "*"
	},
	"log_level": "debug"
}